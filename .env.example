# Copy to .env and fill in real values. Never commit .env.

# Required: OpenAI-compatible API key (OpenAI, Groq, OpenRouter, etc.)
OPENAI_API_KEY=sk-your-key-here

# Optional: leave empty for official OpenAI.
# Groq example: https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Chat model id for the provider above
LLM_MODEL=gpt-4o-mini

# Paths relative to the ELIXIR/ directory (or absolute if you prefer).
# Preserve existing demos: faiss_index_alt/faiss_wine
# After ingest, point at indexes/<version> instead (e.g. indexes/combined-v1).
FAISS_INDEX_PATH=faiss_index_alt/faiss_wine

# Optional: resolve active index as indexes/<INDEX_VERSION> (overrides path above when set)
# INDEX_VERSION=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVER_K=3

# Ingest document text: description | enriched (MVP default: description)
# For Living Liquidz catalog rows, enriched adds style/grape/origin/price.
INGEST_CONTENT_MODE=description

# auto | cpu | cuda
TORCH_DEVICE=auto

# Show Streamlit toasts during init when true
APP_DEBUG=false

# Optional API bind hints (uvicorn CLI still preferred for local runs)
API_HOST=0.0.0.0
API_PORT=8001

# Optional LangChain tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Frontend asset fetch only (Google Stitch SDK). Never commit a real key.
# Used by: cd frontend && npm run fetch:stitch
# STITCH_API_KEY=
